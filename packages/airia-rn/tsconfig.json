{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-native",
    "strict": true,
    "moduleResolution": "bundler",
    "noEmit": true,
    "paths": {
      "@airia/types": ["../airia-types/src/index.ts"],
      "@airia/db": ["./src/db/rnDb.ts"],
